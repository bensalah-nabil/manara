{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/beta", "destination": "/beta.html" },
    { "source": "/beta-ar", "destination": "/beta-ar.html" },
    { "source": "/beta-en", "destination": "/beta-en.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/features-ar", "destination": "/features-ar.html" },
    { "source": "/features-en", "destination": "/features-en.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/start-ar", "destination": "/start-ar.html" },
    { "source": "/start-en", "destination": "/start-en.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://manara-api-pvu4.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
