<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to run the always-visible "managed device" foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- TimeLimitEnforcer (architecture.md §2.2). This is a special, AppOps-backed
         permission with no device-owner silent-grant API, unlike POST_NOTIFICATIONS;
         the parent must grant Usage Access once via Settings > Apps > Special access.
         Declaring it here just makes the app eligible to appear on that screen. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Phase 1 step 5: the sync loop talks to the backend over HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Guided setup finds the phone's own Wi-Fi address for wireless debugging. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LocationEnforcer (architecture.md §2.2). ACCESS_FINE_LOCATION is
         self-granted by OwnerReceiver (ordinary dangerous-level permission,
         unlike PACKAGE_USAGE_STATS) so this never depends on a prompt.
         FOREGROUND_SERVICE_LOCATION is required to declare the service's
         foregroundServiceType below on API 34+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- usesCleartextTraffic is a DEV-ONLY concession for stub-backend, which
         is plain HTTP on a LAN. architecture.md §6 requires TLS in transit;
         remove this once the agent points at a real HTTPS backend, don't
         carry it into anything resembling a release build. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 step 6: the real enrollment screen (manual token + QR). -->
        <activity
            android:name=".enroll.EnrollmentActivity"
            android:exported="false" />

        <!-- The device-owner admin component. ADB targets this:
             dpm set-device-owner com.manara.agent/.OwnerReceiver -->
        <receiver
            android:name=".OwnerReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Restart the visible notice after a reboot (Phase 0 survival test). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ManagedNoticeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the permanent 'this device is managed' notice." />
        </service>

        <!-- LocationEnforcer's visible foreground service (ADR-0001). -->
        <service
            android:name=".location.LocationNoticeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Guided setup: visible while it runs, asks for the pairing code in its notification. -->
        <service
            android:name=".setup.SetupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows guided setup progress and takes the wireless debugging pairing code." />
        </service>
        <receiver
            android:name=".setup.SetupService$SetupInputReceiver"
            android:exported="false" />

        <!-- Only ever instantiated by the OS when Firebase is actually
             initialized (PushConfig.isConfigured); harmless to declare
             unconditionally on a build without a Firebase project set up. -->
        <service
            android:name=".push.ManaraFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
