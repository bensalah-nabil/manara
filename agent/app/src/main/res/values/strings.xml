    <string name="enroll_rejected">That code didn\'t work. Codes work once: ask for a new one in the console.</string>
    <string name="enroll_not_allowed">This phone is managed for a parent account. Only that parent can release it.</string>
    <string name="enroll_failed">Couldn\'t reach Manara. Check the internet connection and try again; the server can take a minute to wake up.</string>
    <string name="scan_empty">That QR code had nothing to read.</string>
