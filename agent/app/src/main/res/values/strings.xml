    <string name="connect_help_new">On the parent\'s phone or computer, open the Manara console and choose Add a phone. Then scan the code it shows.</string>
    <string name="connect_help_move">In the new parent account, choose Add a phone and say Manara is already set up. Then scan the code it shows.</string>
