    <!-- Guided setup screen -->
    <string name="setup_title">Almost there</string>
    <string name="setup_subtitle">This phone is connected to a parent account.</string>
    <string name="setup_unsupported">Guided setup needs Android 11 or newer. This phone can\'t be set up by itself.</string>
    <string name="setup_section">Let Manara manage this phone</string>
    <string name="setup_step_1">Open Settings, then Developer options, and turn on Wireless debugging. The parent\'s console shows how for this phone.</string>
    <string name="setup_step_2">Tap Start guided setup below, and allow notifications.</string>
    <string name="setup_step_3">In Wireless debugging, tap Pair device with QR code and scan the code in the parent\'s console. Or tap Pair device with pairing code and type its code in the console.</string>
    <string name="setup_step_4">Keep the phone on that screen. Everything else is done in the console, which shows each step.</string>
    <string name="setup_running">Setup is running. Pair from the parent\'s console.</string>
