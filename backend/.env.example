# Copy to .env (gitignored) and fill in real values. Never commit .env.

# A real, random password -- "manara"/"manara" only ever existed for the
# earliest local dev iteration, not something to carry further.
POSTGRES_USER=manara
POSTGRES_PASSWORD=change-me-to-something-real
POSTGRES_DB=manara

# "localhost" (the default if unset) makes Caddy use its internal,
# self-signed CA for local HTTPS testing -- verify with curl -k, a phone
# won't trust it without extra setup, and that's fine for now.
#
# Once there's an actual VPS: point this at the real domain's DNS A record
# at the server's IP, set DOMAIN here to that domain, and restart Caddy.
# It automatically requests a real Let's Encrypt certificate instead --
# no other config or code change. That's the whole migration.
DOMAIN=localhost
